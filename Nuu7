local function GetClosestPlayerInFOV()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if IsEnemy(player) and player.Character and player.Character:FindFirstChild(_G.Nuu7Settings.SilentAim.TargetPart) then
            local targetPart = player.Character[_G.Nuu7Settings.SilentAim.TargetPart]
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if distance < shortestDistance and distance <= _G.Nuu7Settings.Aimbot.FOV then
                    closestPlayer = player
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    if not _G.Nuu7Settings.Active then return end
    
    local target = GetClosestPlayerInFOV()
    if target and target.Character and target.Character:FindFirstChild(_G.Nuu7Settings.SilentAim.TargetPart) then
        local targetPos = target.Character[_G.Nuu7Settings.SilentAim.TargetPart].Position
        
        if _G.Nuu7Settings.Aimbot.Enabled then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), _G.Nuu7Settings.Aimbot.Smoothness)
        end
        
        if _G.Nuu7Settings.AutoShoot then
            local ray = Ray.new(Camera.CFrame.Position, (targetPos - Camera.CFrame.Position).Unit * 500)
            local hit, pos = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
            if hit and hit:IsDescendantOf(target.Character) then
                pcall(function() mouse1click() end)
            end
        end
    end
end)

local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if _G.Nuu7Settings.Active and _G.Nuu7Settings.SilentAim.Enabled and tostring(method) == "FindPartOnRayWithIgnoreList" then
        local target = GetClosestPlayerInFOV()
        if target and target.Character and target.Character:FindFirstChild(_G.Nuu7Settings.SilentAim.TargetPart) then
            local origin = args.Origin
            local direction = (target.Character[_G.Nuu7Settings.SilentAim.TargetPart].Position - origin).Unit * 500
            args = Ray.new(origin, direction)
            return OldNamecall(self, unpack(args))
        end
    end
    return OldNamecall(self, ...)
end)
