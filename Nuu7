        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 150, 0, 20)
        label.Position = UDim2.new(1, 10, 0, -2)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = Color3.fromRGB(220, 220, 225)
        label.Font = Enum.Font.SourceSans
        label.TextSize = 16
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = btn

        local active = false
        btn.MouseButton1Click:Connect(function()
            active = not active
            btn.BackgroundColor3 = active and Color3.fromRGB(10, 132, 255) or Color3.fromRGB(63, 63, 66)
            btn.Text = active and "✓" or ""
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            callback(active)
        end)
    end

    local function CreateSlider(name, min, max, parent, position, callback)
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0, 200, 0, 20)
        title.Position = position
        title.BackgroundTransparency = 1
        title.Text = name .. ": " .. min
