local function AddToggle(card, defaultState, callback)
    local Toggle = Instance.new("TextButton")
    Toggle.Size = UDim2.new(0, 42, 0, 22)
    Toggle.Position = UDim2.new(1, -57, 0.5, -11)
    Toggle.BackgroundColor3 = defaultState and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(45, 45, 50)
    Toggle.Text = ""
    Toggle.ZIndex = 6
    Toggle.Parent = card
    Instance.new("UICorner", Toggle).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = defaultState and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 4, 0.5, -8)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.ZIndex = 7
    Knob.Parent = Toggle
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local active = defaultState
    Toggle.MouseButton1Click:Connect(function()
        active = not active
        TweenService:Create(Toggle, TweenInfo.new(0.15), {BackgroundColor3 = active and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(45, 45, 50)}):Play()
        TweenService:Create(Knob, TweenInfo.new(0.15), {Position = active and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 4, 0.5, -8)}):Play()
        callback(active)
    end)
end

local function AddSlider(card, min, max, defaultVal, callback)
    card.Size = UDim2.new(0, 400, 0, 75)
    local ValLabel = Instance.new("TextLabel")
    ValLabel.Size = UDim2.new(0, 40, 0, 20)
    ValLabel.Position = UDim2.new(1, -55, 0, 12)
    ValLabel.BackgroundTransparency = 1
    ValLabel.Text = tostring(defaultVal)
    ValLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    ValLabel.Font = Enum.Font.SourceSans
    ValLabel.TextSize = 13
    ValLabel.ZIndex = 6
    ValLabel.Parent = card

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(0, 370, 0, 4)
    Track.Position = UDim2.new(0, 15, 0, 56)
    Track.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    Track.ZIndex = 6
    Track.Parent = card

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((defaultVal - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
    Fill.ZIndex = 7
    Fill.Parent = Track

    local Knob = Instance.new("TextButton")
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = UDim2.new((defaultVal - min)/(max - min), -6, 0.5, -6)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Text = ""
    Knob.ZIndex = 8
    Knob.Parent = Track

    local sliding = false
    Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            Knob.Position = UDim2.new(rel, -6, 0.5, -6)
            local val = math.floor(min + (max - min) * rel)
            ValLabel.Text = tostring(val)
            callback(val)
        end
    end)
end

