-- Validación de Enemigos en Duels (One-Shot Roles Check)
local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if player.Team ~= LocalPlayer.Team then return true end
    -- Escaneo de inventario/mochila en tiempo real para Sheriff vs Murder
    if player:FindFirstChild("Backpack") and (player.Backpack:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Gun")) then
        return true
    end
    if player.Character and (player.Character:FindFirstChild("Knife") or player.Character:FindFirstChild("Gun")) then
        return true
    end
    return false
end

