-- Nuu7 Hub - Desenvolvido por LiamX (Parte 4)
local function IsEnemy(player)
    if not _G.Nuu7Settings.ESP.TeamCheck then return true end
    if player == LocalPlayer then return false end
    if player.Team ~= LocalPlayer.Team then return true end
    if player:FindFirstChild("Backpack") and (player.Backpack:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Gun")) then return true end
    if player.Character and (player.Character:FindFirstChild("Knife") or player.Character:FindFirstChild("Gun")) then return true end
    return false
end

RunService.RenderStepped:Connect(function()
    if not _G.Nuu7Settings.Active then return end
    
    if _G.Nuu7Settings.Movement.Enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = _G.Nuu7Settings.Movement.WalkSpeed
    end

    for _, p in pairs(Players:GetPlayers()) do
        if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            if _G.Nuu7Settings.Hitbox.Enabled then
                hrp.Size = Vector3.new(_G.Nuu7Settings.Hitbox.Size, _G.Nuu7Settings.Hitbox.Size, _G.Nuu7Settings.Hitbox.Size)
                hrp.Transparency = 1 
                hrp.CanCollide = false
            else
                hrp.Size = Vector3.new(2, 2, 1)
            end
        end
    end
end)

