    if _G.Nuu7Settings.InstaKillAll then
        for _, enemy in pairs(Players:GetPlayers()) do
            if IsEnemy(enemy) and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                -- Validación de arma equipada localmente
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") then
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    
                    -- Simulación de evento de disparo nativo para evitar teletransportación física
                    if tool:FindFirstChild("RemoteEvent") then
                        tool.RemoteEvent:FireServer(enemy.Character.HumanoidRootPart.Position)
                    elseif tool:FindFirstChild("Fire") then
                        tool.Fire:FireServer(enemy.Character.HumanoidRootPart.Position)
                    elseif tool:FindFirstChild("Shoot") then
                        tool.Shoot:FireServer(enemy.Character.HumanoidRootPart.Position)
                    end
                end
            end
        end
    end
end)

